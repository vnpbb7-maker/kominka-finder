# Kominka Finder — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git.

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...  # Settings → API → service_role key (NOT anon key)

# ── Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=AIza...   # aistudio.google.com → Get API key

# ── Optional overrides ────────────────────────────────────────
MAX_PAGES=10          # pages to scrape per site per run
SKIP_SCORING=false    # set true to skip Gemini scoring (saves quota)
